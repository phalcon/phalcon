parameters:
    paths:
        - ../src
    level: 1
    tmpDir: ../tests/_output
    ignoreErrors:
        - "#Unsafe usage of new static#"
        # The bundled phpredis stub declares RedisCluster::flushAll() as taking
        # a string, while the extension also accepts the [host, port] pairs
        # that _masters() returns.
        -
            message: "#Parameter \\#1 \\$key_or_address of method RedisCluster::flushAll\\(\\) expects string, mixed given#"
            path: ../src/Storage/Adapter/RedisCluster.php
            reportUnmatched: false
        # The bundled stub declares the spl_autoload_register() callback as
        # returning void, while PHP accepts any callable and discards the
        # return value. Loader::autoload() is public API and returns bool.
        -
            message: "#Parameter \\#1 \\$callback of function spl_autoload_register expects \\(callable\\(string\\): void\\)\\|null, array\\{\\$this\\(Phalcon\\\\Autoload\\\\Loader\\), 'autoload'\\} given#"
            path: ../src/Autoload/Loader.php
            reportUnmatched: false
        # The dispatch loop sets `finished` to true, then fires events and
        # handler hooks. Any listener or hook may call forward(), which sets
        # it back to false. PHPStan cannot follow that re-entry, so it still
        # believes the property holds the value last assigned here.
        -
            message: "#Strict comparison using [!=]== between true and false will always evaluate to (true|false)#"
            path: ../src/Dispatcher/AbstractDispatcher.php
            reportUnmatched: false
        # `handlerHookCache` caches the method_exists() probes once per handler
        # class, so the presence check and the call sit in different
        # statements. PHPStan only narrows an object on an inline
        # method_exists() call.
        -
            message: "#Call to an undefined method object::(beforeExecuteRoute|initialize|afterBinding|afterExecuteRoute)\\(\\)#"
            path: ../src/Dispatcher/AbstractDispatcher.php
            reportUnmatched: false
        # `params` is a typed array property here, so the guard is unreachable
        # in PHP. It is kept because the Zephir property is untyped, where the
        # same guard is live and raises EXCEPTION_INVALID_PARAMS.
        -
            message: "#Call to function is_array\\(\\) with array<mixed> will always evaluate to true#"
            path: ../src/Dispatcher/AbstractDispatcher.php
            reportUnmatched: false
        # `registerModules()` documents the shape it expects but does not
        # validate it, so a module definition can still be any type at run
        # time. These guards are what reports that, and they are live in the
        # Zephir implementation where the modules array is untyped.
        -
            message: "#(Call to function is_object\\(\\) with Closure will always evaluate to true|Result of && is always false|Instanceof between Closure and Closure will always evaluate to true)#"
            path: ../src/Cli/Console.php
            reportUnmatched: false
        # `parseConfig()` accepts `mixed`, so an int or a plain object can
        # still reach the guard at run time. Only the narrower docblock makes
        # it look redundant. The same guard is live in the Zephir
        # implementation, where the parameter is untyped.
        -
            message: "#Call to function is_array\\(\\) with array<mixed> will always evaluate to true#"
            path: ../src/Config/ConfigFactory.php
            reportUnmatched: false
        # `Attributes` is a Collection users populate freely, so a value stays
        # `mixed` after the array/resource guards that raise
        # AttributeNotRenderable. `AttributeEscaper::escape()` takes `mixed`
        # natively; only the documented shape looks narrower.
        -
            message: "#Parameter \\#1 \\$input of method Phalcon\\\\Html\\\\Escaper\\\\AttributeEscaper::escape\\(\\) expects .*, mixed given#"
            path: ../src/Html/Attributes.php
            reportUnmatched: false
        # `renderArrayElements()` dispatches by method name into the concrete
        # helper, so the callable and its return type are only known at run
        # time. The names come from `AbstractSeries::$store`, whose entries
        # each name a render method the subclass provides.
        -
            message: "#(Binary operation \"\\.\" between string and mixed results in an error|Parameter \\#1 \\$callback of function call_user_func_array expects callable\\(\\): mixed, array\\{\\$this\\(Phalcon\\\\Html\\\\Helper\\\\AbstractHelper\\), string\\} given)#"
            path: ../src/Html/Helper/AbstractHelper.php
            reportUnmatched: false
        # `EscaperInterface::attributes()` still declares `string` while the
        # `Escaper` implementation it always resolves to takes `mixed`. Its own
        # docblock records that the widened signature lands in the next major.
        # Until then a bool or numeric attribute value is valid at run time.
        -
            message: "#Parameter \\#1 \\$input of method Phalcon\\\\Html\\\\Escaper\\\\EscaperInterface::attributes\\(\\) expects string, .* given#"
            path: ../src/Html/Helper/AbstractHelper.php
            reportUnmatched: false
        # The two group entries in the `@method` block already sit at the
        # 120-character limit with a bare `array`, so no value type - aliased
        # or spelled out - fits, and PHPStan cannot parse a wrapped `@method`
        # signature. The 45 other entries carry their shapes.
        -
            message: "#PHPDoc tag @method for method input(Checkbox|Radio)Group\\(\\) parameter \\#\\d+ \\$\\w+ with no value type specified in iterable type array#"
            path: ../src/Html/TagFactory.php
            reportUnmatched: false
        # `invokeRule()` gets the rule that `allow()` or `deny()` stored, which
        # is any `callable`. `ReflectionFunction` takes only `Closure|string`,
        # so an array callable fails at run time. The Zephir source has the
        # same hole, where the parameter is `var`. A narrower parameter type is
        # a next major change.
        -
            message: "#Parameter \\#1 \\$function of class ReflectionFunction constructor expects Closure\\|string, callable\\(\\): mixed given#"
            path: ../src/Acl/Adapter/Memory.php
            reportUnmatched: false
        # `newInstance()` is a service locator returning `object`. Every helper
        # it builds is invokable, but the registry is keyed by service name, so
        # the `__invoke()` on the resolved instance cannot be proven statically.
        -
            message: "#Parameter \\#1 \\$callback of function call_user_func_array expects callable\\(\\): mixed, array\\{object, '__invoke'\\} given#"
            path: ../src/Html/TagFactory.php
            reportUnmatched: false
        # The loaders only prove that the decoded document is an array. The
        # per-entry shape is checked in `ArrayLoader::validateDefinition()`,
        # which PHPStan cannot follow back to the constructor argument. The
        # loader chain is reworked in the next major.
        -
            message: "#Parameter \\#1 \\$definitions of class Phalcon\\\\Forms\\\\Loader\\\\ArrayLoader constructor expects array<int, array<string, mixed>>, (list|array<mixed, mixed>) given#"
            paths:
                - ../src/Forms/Loader/JsonLoader.php
                - ../src/Forms/Loader/YamlLoader.php
            reportUnmatched: false
        # `setFilters()` takes `array|string` natively, so the type guard is
        # unreachable in PHP. It is kept because the Zephir parameter is `var`,
        # where the same guard is live and raises `InvalidFilterType`.
        -
            message: "#(Call to function is_array\\(\\) with array<array<mixed>\\|string> will always evaluate to true|Result of && is always false)#"
            path: ../src/Forms/Element/AbstractElement.php
            reportUnmatched: false
        # `ElementInterface::label()` declares no parameter, as in the Zephir
        # source, while `AbstractElement::label()` takes the attributes and
        # `Form::label()` passes them. The interface is widened in the next
        # major.
        -
            message: "#Method Phalcon\\\\Forms\\\\Element\\\\ElementInterface::label\\(\\) invoked with 1 parameter, 0 required#"
            path: ../src/Forms/Form.php
            reportUnmatched: false
        # `bind()` accepts an array or an object as the data source, and a
        # plain object is iterated by its public properties - the same as the
        # Zephir `for..in`, which walks the property table rather than calling
        # the Iterator methods. PHPStan has no type for that, so the check is
        # silenced instead of asserting a Traversable the value does not have.
        -
            message: "#Argument of an invalid type array<mixed>\\|object supplied for foreach, only iterables are supported#"
            path: ../src/Filter/Validation.php
            reportUnmatched: false
        # `rules()` documents its list as validators, but does not validate it.
        # The guard is what skips anything else, and it is live in the Zephir
        # implementation where the array is untyped.
        -
            message: "#Instanceof between Phalcon\\\\Filter\\\\Validation\\\\ValidatorInterface and Phalcon\\\\Filter\\\\Validation\\\\ValidatorInterface will always evaluate to true#"
            path: ../src/Filter/Validation.php
            reportUnmatched: false
        # The sanitizer keeps the pre-8.1 behavior of `filter_var()`. PHPStan
        # resolves `PHP_MAJOR_VERSION` and `PHP_MINOR_VERSION` to the version
        # it runs on, so the version guard looks dead to it while it is live
        # on every other version.
        -
            message: "#(Comparison operation \"<\" between 8 and 8 is always false|Result of (\\|\\||&&) is always false|Strict comparison using === between (8 and 8|int<1, 5> and 0) will always evaluate to (true|false))#"
            path: ../src/Filter/Sanitize/StringValLegacy.php
            reportUnmatched: false
        # `isUniquenessModel()` reaches the branch inside a `foreach` over the
        # field list, so PHPStan knows the list is not empty and reads the
        # count guard as redundant. It is kept as the third arm of the chain,
        # as in the Zephir source.
        -
            message: "#Comparison operation \">\" between int<2, max> and 1 is always true#"
            path: ../src/Filter/Validation/Validator/Uniqueness.php
            reportUnmatched: false
